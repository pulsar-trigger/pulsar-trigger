    <!-- IntervalometerPanel -->
    <string name="panel_intervalometer">Intervalometer</string>
    <string name="panel_intervalometer_help">Automate complex timelapse sequences or burst captures with precision timing.\n\n• Set your camera to Bulb mode so Pulsar controls the shutter.\n• Interval is the time from the start of one shot to the next.\n• Exposure is how long the shutter stays open per shot.\n• Start Delay gives you time to step away before the sequence begins.\n• The Sequence Estimate card shows total duration and duty cycle.</string>
    <string name="label_sequence_estimate">Sequence Estimate</string>
    <string name="label_shots">Shots</string>
    <string name="label_total_duration">Total Duration</string>
    <string name="label_duty_cycle">Duty Cycle: %1$d%% active exposure</string>
    <string name="label_interval">Interval</string>
    <string name="label_exposure">Exposure</string>
    <string name="label_start_delay">Start Delay</string>
    <string name="label_number_of_shots">Number of Shots</string>

    <!-- ManualPanel -->
    <string name="panel_manual">Manual Shutter</string>
    <string name="panel_manual_help">Direct manual shutter control with two modes.\n\n• HOLD: The shutter stays open as long as you press the button. Release to close. Ideal for quick bulb shots.\n• LOCK: Tap once to open the shutter, tap again to close. Best for long exposures where you don\u2019t want to hold the button.\n\nSwitch between Hold and Lock using the segmented buttons in the action area.</string>
    <string name="panel_manual_tip">Toggle behaviour using the chips in the action area below.</string>
    <string name="panel_manual_lock_info">LOCK: Tap the center button once to open the shutter, tap again to close. Best for long bulb exposures.</string>
    <string name="panel_manual_hold_info">HOLD: Shutter remains open as long as the center button is pressed. Ideal for quick bursts.</string>

    <!-- AstroPanel -->
    <string name="panel_astro">Astro Mode</string>
    <string name="panel_astro_help">Calculate the longest exposure that keeps stars as sharp points instead of trails.\n\n• Choose your sensor preset (crop factor) and lens focal length.\n• The 500 Rule is a classic formula; the 400 Rule is tighter and better for high-resolution sensors.\n• Formula: Rule ÷ (focal length × crop factor) = max seconds.\n• Gap is the pause between exposures for the camera to write to card.\n• Adjust shot count and delay just like in Intervalometer mode.</string>
    <string name="label_rule_readout">%1$d Rule Readout</string>
    <string name="label_effective_focal">%1$smm Effective</string>
    <string name="label_max_exposure">Max Exposure</string>
    <string name="label_astro_formula">Formula: %1$d / (%2$d mm × %3$sx) = %4$ss</string>
    <string name="label_optics_configuration">Optics Configuration</string>
    <string name="label_sensor_preset">Sensor Preset</string>
    <string name="preset_full_frame">Full Frame</string>
    <string name="preset_aps_c_canon">APS-C (Canon)</string>
    <string name="preset_aps_c_nikon_sony">APS-C (Nikon/Sony)</string>
    <string name="preset_micro_43">Micro 4/3</string>
    <string name="label_focal_length">Lens Focal Length</string>
    <string name="label_capture_sequence">Capture Sequence</string>

