    <!-- IntervalometerPanel -->
    <string name="panel_intervalometer_help">Automate complex timelapse sequences or burst captures with precision timing.\n\n• Set your camera to Bulb mode so Pulsar controls the shutter.\n• Interval is the gap between exposures — the wait time after one shot before the next fires.\n• Exposure is how long the shutter stays open per shot.\n• Cycle time per frame = exposure + interval.\n• Start Delay gives you time to step away before the sequence begins.\n• The Sequence Estimate card shows total duration and end time.</string>
    <string name="label_shots">Shots</string>
    <string name="label_total_duration">Total Duration</string>
    <string name="label_ends_at">Ends at %1$s</string>

