    <string name="label_focus_pin">Focus Pin</string>
    <string name="gpio_simulator_note">GPIO configuration not available in simulator mode</string>
    <string name="section_backup_restore">Backup &amp; Restore</string>
    <string name="backup_restore_help">Save and restore all your Pulsar settings.\n\n• Export creates a JSON file with all preferences, defaults, GPIO config, and planner data.\n• Import loads settings from a previously exported file.\n• Use this to transfer your setup to a new phone or as a safety backup.</string>
