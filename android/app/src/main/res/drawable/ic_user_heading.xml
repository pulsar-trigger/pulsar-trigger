    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#80FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.4"
        android:pathData="M12,2 L17,11 L12,9 L7,11 Z" />
</vector>
