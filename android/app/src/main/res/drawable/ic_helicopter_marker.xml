<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-down helicopter silhouette, nose pointing UP (heading 0° / north).
  Used by Aircraft Watch for rotorcraft map markers; AircraftWatchScreen.kt
  rotates + tints a copy per marker (SRC_IN), so only the shape matters.
  The crossed main-rotor blades over a stubby fuselage + thin tail boom is
  the at-a-glance "this is a chopper, not a plane" cue.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Main rotor blades (crossed X over the hub) -->
    <path
        android:fillColor="#1976D2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.3"
        android:pathData="M3.6,3.6 L19.6,15.6 L19.0,16.4 L3.0,4.4 Z" />
    <path
        android:fillColor="#1976D2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.3"
        android:pathData="M20.4,3.6 L4.4,15.6 L5.0,16.4 L21.0,4.4 Z" />
    <!-- Tail boom -->
    <path
        android:fillColor="#1976D2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.3"
        android:pathData="M11.3,12 L12.7,12 L12.7,20 L11.3,20 Z" />
    <!-- Tail rotor -->
    <path
        android:fillColor="#1976D2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.3"
        android:pathData="M9.6,19.2 L14.4,19.2 L14.4,20.4 L9.6,20.4 Z" />
    <!-- Fuselage (nose up) -->
    <path
        android:fillColor="#1976D2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.6"
        android:pathData="M12,5 C13.7,5 14.6,7 14.6,9.6 C14.6,12.2 13.5,14 12,14 C10.5,14 9.4,12.2 9.4,9.6 C9.4,7 10.3,5 12,5 Z" />
</vector>
