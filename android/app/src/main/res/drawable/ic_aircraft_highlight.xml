<?xml version="1.0" encoding="utf-8"?>
<!--
  Highlight ring drawn UNDER (visually around) the selected aircraft
  marker on the Aircraft Watch map. Semi-transparent yellow stroke +
  faint fill so the plane icon stays readable through the centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer ring -->
    <path
        android:strokeColor="#FFFFEB3B"
        android:strokeWidth="1.6"
        android:fillColor="#33FFEB3B"
        android:pathData="M12,12 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
</vector>
