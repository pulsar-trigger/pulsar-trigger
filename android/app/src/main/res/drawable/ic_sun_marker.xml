<?xml version="1.0" encoding="utf-8"?>
<!--
  Sun marker for the Aircraft Watch map. Each ray is a separate <path>
  so we don't rely on multi-subpath M commands rendering correctly on
  every Android vector-drawable parser. Bright yellow disc with a thick
  outline so it reads on both light and dark map tiles.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 8 rays around the disc -->
    <path android:strokeColor="#FFC107" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M12,1 L12,4" />
    <path android:strokeColor="#FFC107" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M12,20 L12,23" />
    <path android:strokeColor="#FFC107" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M1,12 L4,12" />
    <path android:strokeColor="#FFC107" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M20,12 L23,12" />
    <path android:strokeColor="#FFC107" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M4,4 L6,6" />
    <path android:strokeColor="#FFC107" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M18,18 L20,20" />
    <path android:strokeColor="#FFC107" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M4,20 L6,18" />
    <path android:strokeColor="#FFC107" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M18,6 L20,4" />
    <!-- Disc -->
    <path
        android:fillColor="#FFD600"
        android:strokeColor="#E65100"
        android:strokeWidth="1.0"
        android:pathData="M12,12 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
